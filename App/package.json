{
  "name": "bilbostack-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "loadtest": "node loadtest/loadtest.mjs",
    "loadtest:stress": "node loadtest/loadtest.mjs --url http://127.0.0.1:4173 --users 200 --duration 30 --think 0 --json loadtest/results/local-200vu-stress.json",
    "loadtest:realistic": "node loadtest/loadtest.mjs --url http://127.0.0.1:4173 --users 200 --duration 30 --think 3000 --json loadtest/results/local-200vu-realistic.json"
  },
  "dependencies": {
    "html5-qrcode": "^2.3.8",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "snes.css": "^1.0.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.0",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
